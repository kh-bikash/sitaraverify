# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local Codex skills and preview logs
/.agents/
/skills-lock.json
/dev-server.log
/dev-server.err.log
/.venv/
/.paddlex-cache/
/.handwriting-cache/
/.handwriting-build/
/.handwriting-data/
/.handwriting-model/
/.handwriting-models/
/.handwriting-venv/
/.tmp-platter/
/.tmp-doctr/
/ocr_service/test_output/
/ocr_service/uploads/
/ocr_service/*.log
/handwriting_service/*.log

# retired local-model prototypes (the product uses the Gemini server route)
/ocr_service/
/handwriting_service/
/scripts/
